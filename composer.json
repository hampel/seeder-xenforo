{
	"description": "Test data generator for XenForo development installs",
	"license": "MIT",
	"require": {
		"php": ">=8.1",
		"fakerphp/faker": "^1.24"
	},
	"replace": {
		"psr/container": "*",
		"symfony/deprecation-contracts": "*"
	},
	"require-dev": {
		"hampel/xenforo-test-framework": "^5.5",
		"phpunit/phpunit": "^12.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3"
		}
	}
}
